"Seepage under a sheet pile wall<hr/><small>Steady confined seepage, by finite differences on a square grid</small>
'<!--section:soil-->
'Permeability, vertical: 'k_1 = ? {1e-5}m/s' to the depth 't_1 = ? {8.6}m', then 'k_2 = ? {1e-5}m/s
'Horizontal to vertical permeability: 'r_k = ? {1}
'Saturated unit weight: 'γ_sat = ? {20}kN/m^3', water: 'γ_w = 9.81kN/m^3
'<!--section:geometry-->
'Impermeable base below the upstream ground: 'T = ? {8.6}m
'Toe of the wall below the upstream ground: 'd = ? {6}m', excavation in front of the wall: 'e_x = ? {0}m
'Section modelled: 'L_1 = ? {12}m' upstream and 'L_2 = ? {12}m' downstream of the wall, in square cells of 'Δ = ? {0.2}m
'<!--section:water-->
'Water above the ground: 'h_1 = ? {4.5}m' upstream, 'h_2 = ? {0.5}m' downstream
'<div>
#hide
'Section to scale, in px: the wall at L_1 from the left, z up from the upstream ground
w_L = (L_1 + L_2)/1m
w_z = max(h_1; h_2 - e_x; 0m)/1m + 1
w_s = min(520/w_L; 240/(T/1m + w_z))
w_0 = 78
w_W = w_0 + L_1/1m*w_s
w_R = w_0 + w_L*w_s
w_g = 22 + w_z*w_s
w_e = w_g + e_x/1m*w_s
w_b = w_g + T/1m*w_s
w_d = w_g + d/1m*w_s
w_t = w_g + min(t_1; T)/1m*w_s
w_1 = w_g - h_1/1m*w_s
w_2 = w_e - h_2/1m*w_s
w_H = round(w_R + 78)
w_V = round(w_b + 50)
w_n = floor((w_R - w_0)/8) - 1
#show
#val
'<svg alt="section.svg" width="'w_H'" height="'w_V'" xmlns="http://www.w3.org/2000/svg" font-family="Libre Franklin, Arial, sans-serif" font-size="11" fill="#1C1710">
'<rect x="'w_0'" y="'w_1'" width="'w_W - w_0'" height="'w_g - w_1'" fill="#2E63C4" fill-opacity="0.15"/>
'<rect x="'w_W'" y="'w_2'" width="'w_R - w_W'" height="'w_e - w_2'" fill="#2E63C4" fill-opacity="0.15"/>
'<rect x="'w_0'" y="'w_g'" width="'w_W - w_0'" height="'w_b - w_g'" fill="#EFE8DA"/>
'<rect x="'w_W'" y="'w_e'" width="'w_R - w_W'" height="'w_b - w_e'" fill="#EFE8DA"/>
#if t_1 < T
'<rect x="'w_0'" y="'max(w_t; w_g)'" width="'w_W - w_0'" height="'w_b - max(w_t; w_g)'" fill="#E2D5BB"/>
'<rect x="'w_W'" y="'max(w_t; w_e)'" width="'w_R - w_W'" height="'w_b - max(w_t; w_e)'" fill="#E2D5BB"/>
'<text x="'w_R - 6'" y="'w_t + 14'" text-anchor="end" font-style="italic">k<tspan font-size="8" dy="2">2</tspan></text>
#end if
'<text x="'w_0 + 6'" y="'w_g + 14'" font-style="italic">k<tspan font-size="8" dy="2">1</tspan></text>
'<line x1="'w_0'" y1="'w_g'" x2="'w_W'" y2="'w_g'" stroke="#1C1710" stroke-width="1"/>
'<line x1="'w_W'" y1="'w_e'" x2="'w_R'" y2="'w_e'" stroke="#1C1710" stroke-width="1"/>
#if h_1 > 0m
'<line x1="'w_0'" y1="'w_1'" x2="'w_W'" y2="'w_1'" stroke="#2E63C4" stroke-width="1"/>
'<polygon points="'w_0 + 24','w_1' 'w_0 + 18','w_1 - 8' 'w_0 + 30','w_1 - 8'" fill="#2E63C4"/>
#end if
#if h_2 > 0m
'<line x1="'w_W'" y1="'w_2'" x2="'w_R'" y2="'w_2'" stroke="#2E63C4" stroke-width="1"/>
'<polygon points="'w_R - 24','w_2' 'w_R - 30','w_2 - 8' 'w_R - 18','w_2 - 8'" fill="#2E63C4"/>
#end if
'<line x1="'w_0'" y1="'w_b'" x2="'w_R'" y2="'w_b'" stroke="#1C1710" stroke-width="1.5"/>
#for k = 0 : w_n
'<line x1="'w_0 + 8*k'" y1="'w_b + 8'" x2="'w_0 + 8*k + 8'" y2="'w_b'" stroke="#1C1710" stroke-width="0.6"/>
#loop
'<line x1="'w_W'" y1="'w_g - (w_z - 0.4)*w_s'" x2="'w_W'" y2="'w_d'" stroke="#1C1710" stroke-width="3"/>
'<line x1="'w_0 - 12'" y1="'w_g'" x2="'w_0 - 12'" y2="'w_b'" stroke="#1C1710" stroke-width="0.75"/>
'<line x1="'w_0 - 16'" y1="'w_b'" x2="'w_0 - 8'" y2="'w_b'" stroke="#1C1710" stroke-width="0.75"/>
'<line x1="'w_0 - 16'" y1="'w_g'" x2="'w_0 - 8'" y2="'w_g'" stroke="#1C1710" stroke-width="0.75"/>
'<text x="'w_0 - 16'" y="'(w_g + w_b)/2 + 4'" text-anchor="end"><tspan font-style="italic">T</tspan> = 'T/1m' m</text>
#if h_1 > 0m
'<line x1="'w_0 - 12'" y1="'w_1'" x2="'w_0 - 12'" y2="'w_g'" stroke="#1C1710" stroke-width="0.75"/>
'<line x1="'w_0 - 16'" y1="'w_1'" x2="'w_0 - 8'" y2="'w_1'" stroke="#1C1710" stroke-width="0.75"/>
'<text x="'w_0 - 16'" y="'(w_1 + w_g)/2 + 4'" text-anchor="end"><tspan font-style="italic">h</tspan><tspan font-size="8" dy="2">1</tspan><tspan dy="-2"> = 'h_1/1m' m</tspan></text>
#end if
'<line x1="'w_W - 10'" y1="'w_g'" x2="'w_W - 10'" y2="'w_d'" stroke="#1C1710" stroke-width="0.75"/>
'<line x1="'w_W - 14'" y1="'w_d'" x2="'w_W - 6'" y2="'w_d'" stroke="#1C1710" stroke-width="0.75"/>
'<text x="'w_W - 14'" y="'(w_g + w_d)/2 + 4'" text-anchor="end"><tspan font-style="italic">d</tspan> = 'd/1m' m</text>
#if e_x > 0m
'<line x1="'w_W + 10'" y1="'w_g'" x2="'w_W + 10'" y2="'w_e'" stroke="#1C1710" stroke-width="0.75"/>
'<line x1="'w_W + 6'" y1="'w_g'" x2="'w_W + 14'" y2="'w_g'" stroke="#1C1710" stroke-width="0.75"/>
'<text x="'w_W + 14'" y="'(w_g + w_e)/2 + 4'"><tspan font-style="italic">e</tspan><tspan font-size="8" dy="2">x</tspan><tspan dy="-2"> = 'e_x/1m' m</tspan></text>
#end if
#if h_2 > 0m
'<line x1="'w_R + 12'" y1="'w_2'" x2="'w_R + 12'" y2="'w_e'" stroke="#1C1710" stroke-width="0.75"/>
'<line x1="'w_R + 8'" y1="'w_2'" x2="'w_R + 16'" y2="'w_2'" stroke="#1C1710" stroke-width="0.75"/>
'<line x1="'w_R + 8'" y1="'w_e'" x2="'w_R + 16'" y2="'w_e'" stroke="#1C1710" stroke-width="0.75"/>
'<text x="'w_R + 18'" y="'(w_2 + w_e)/2 + 4'"><tspan font-style="italic">h</tspan><tspan font-size="8" dy="2">2</tspan><tspan dy="-2"> = 'h_2/1m' m</tspan></text>
#end if
#if t_1 < T
'<line x1="'w_R + 12'" y1="'w_g'" x2="'w_R + 12'" y2="'w_t'" stroke="#1C1710" stroke-width="0.75"/>
'<line x1="'w_R + 8'" y1="'w_t'" x2="'w_R + 16'" y2="'w_t'" stroke="#1C1710" stroke-width="0.75"/>
'<text x="'w_R + 18'" y="'(w_g + w_t)/2 + 4'"><tspan font-style="italic">t</tspan><tspan font-size="8" dy="2">1</tspan><tspan dy="-2"> = 't_1/1m' m</tspan></text>
#end if
'<line x1="'w_0'" y1="'w_b + 24'" x2="'w_R'" y2="'w_b + 24'" stroke="#1C1710" stroke-width="0.75"/>
'<line x1="'w_0'" y1="'w_b + 20'" x2="'w_0'" y2="'w_b + 28'" stroke="#1C1710" stroke-width="0.75"/>
'<line x1="'w_W'" y1="'w_b + 20'" x2="'w_W'" y2="'w_b + 28'" stroke="#1C1710" stroke-width="0.75"/>
'<line x1="'w_R'" y1="'w_b + 20'" x2="'w_R'" y2="'w_b + 28'" stroke="#1C1710" stroke-width="0.75"/>
'<text x="'(w_0 + w_W)/2'" y="'w_b + 40'" text-anchor="middle"><tspan font-style="italic">L</tspan><tspan font-size="8" dy="2">1</tspan><tspan dy="-2"> = 'L_1/1m' m</tspan></text>
'<text x="'(w_W + w_R)/2'" y="'w_b + 40'" text-anchor="middle"><tspan font-style="italic">L</tspan><tspan font-size="8" dy="2">2</tspan><tspan dy="-2"> = 'L_2/1m' m</tspan></text>
'</svg>
#equ
'</div>
'<!--section:grid-->
'<div>
'<p>Total head <i>h</i> = <i>z</i> + <i>u</i>/<i>γ</i><sub>w</sub>, with the elevation <i>z</i> measured up from the upstream ground.</p>
'Head at the upstream ground: 'H_1 = h_1
'Head at the downstream ground: 'H_2 = h_2 - e_x
'Difference: 'ΔH = H_1 - H_2
#hide
'Cells of δ (m) across, rows down; heads in m and permeabilities relative to k_1, as plain numbers
δ = Δ/1m
n_1 = max(round(L_1/Δ); 2)
n_2 = max(round(L_2/Δ); 2)
n_x = n_1 + n_2
n_z = max(round(T/Δ); 3)
n_d = min(max(round(d/Δ); 1); n_z - 1)
n_e = min(max(round(e_x/Δ); 0); n_d - 1)
n_t = min(max(round(t_1/Δ); 0); n_z)
η_1 = H_1/1m
η_2 = H_2/1m
κ_v(j) = if(j ≤ n_t; 1; k_2/k_1)
κ_h(j) = r_k*κ_v(j)
κ_z(j) = 2*κ_v(j)*κ_v(j + 1)/(κ_v(j) + κ_v(j + 1))
'Downstream, the cells above the excavation are not soil. Cells are numbered down each column in
'turn, so that the system of equations is banded.
j_t(i) = if(i ≤ n_1; 1; n_e + 1)
N_c(i; j) = if(i ≤ n_1; (i - 1)*n_z + j; n_1*n_z + (i - n_1 - 1)*(n_z - n_e) + j - n_e)
n_c = n_1*n_z + n_2*(n_z - n_e)
K_s = symmetric_hp(n_c)
R_s = vector_hp(n_c)
#for i = 1 : n_x
	j_0 = j_t(i)
	#for j = j_0 : n_z
		p = N_c(i; j)
		#if j ≡ j_0
			c_n = 2*κ_v(j)
			K_s.(p; p) = K_s.(p; p) + c_n
			R_s.(p) = c_n*if(i ≤ n_1; η_1; η_2)
		#end if
		#if j < n_z
			c_n = κ_z(j)
			K_s.(p; p) = K_s.(p; p) + c_n
			K_s.(p + 1; p + 1) = K_s.(p + 1; p + 1) + c_n
			K_s.(p; p + 1) = -c_n
		#end if
		#if i < n_x ∧ (i ≠ n_1 ∨ j > n_d)
			c_n = κ_h(j)
			r = N_c(i + 1; j)
			K_s.(p; p) = K_s.(p; p) + c_n
			K_s.(r; r) = K_s.(r; r) + c_n
			K_s.(p; r) = -c_n
		#end if
	#loop
#loop
h_s = clsolve(K_s; R_s)
'Heads by row and column; above the excavation, that of the water
Φ = matrix_hp(n_z; n_x)
#for i = 1 : n_x
	#for j = 1 : n_z
		#if i ≤ n_1 ∨ j > n_e
			Φ.(j; i) = h_s.(N_c(i; j))
		#else
			Φ.(j; i) = η_2
		#end if
	#loop
#loop
'Flow under the toe and, as a check, into the upstream ground (equal to rounding)
q_n = 0
#for j = n_d + 1 : n_z
	q_n = q_n + κ_h(j)*(Φ.(j; n_1) - Φ.(j; n_1 + 1))
#loop
q_in = 0
#for i = 1 : n_1
	q_in = q_in + 2*κ_v(1)*(η_1 - Φ.(1; i))
#loop
q_Δ = q_n*1m
'For the checks: the head in the cell at the downstream ground next to the wall, and the mean excess
'head at the base of the heave prism (at the level of the toe, between the rows above and below it)
h_ex = Φ.(n_e + 1; n_1 + 1)*1m
n_b = min(max(round((d - e_x)/2/Δ); 1); n_2)
s_m = 0
#for i = n_1 + 1 : n_1 + n_b
	s_m = s_m + (Φ.(n_d; i) + Φ.(n_d + 1; i))/2 - η_2
#loop
h_m = s_m/n_b*1m
#show
#val
'<p>Grid: 'n_x' × 'n_z' cells, to the base at 'n_z*δ' m and the toe at 'n_d*δ' m; 'n_c' equations.</p>
#equ
'<p>In each cell the flows to its neighbours balance (the Laplace equation): Σ <i>c</i>·(<i>h</i><sub>n</sub> − <i>h</i>) = 0, with the conductance <i>c</i> = <i>k</i><sub>h</sub> = <i>r</i><sub>k</sub>·<i>k</i><sub>v</sub> to the cells beside it, <i>k</i><sub>v</sub> to those above and below (2<i>k</i><sub>1</sub><i>k</i><sub>2</sub>/(<i>k</i><sub>1</sub> + <i>k</i><sub>2</sub>) across the layer boundary), 2<i>k</i><sub>v</sub> to the ground half a cell above, and 0 across the wall and the edges of the section. The equations are solved together, by Cholesky decomposition.</p>
'</div>
'<!--section:flow-->
'<div>
'<p>Flow under the toe, per metre of wall, with <i>q</i><sub>Δ</sub> = Σ <i>k</i><sub>h</sub>/<i>k</i><sub>1</sub>·(<i>h</i><sub>left</sub> − <i>h</i><sub>right</sub>) over the cells below the toe:</p>
q = k_1*q_Δ|m^2/s
'<p>Flow net: 'N_d = 12' drops of head</p>
'<p>Flow channels (<i>N</i><sub>f</sub>/<i>N</i><sub>d</sub> = <i>q</i>/(<i>k</i><sub>1</sub>·Δ<i>H</i>)): 'N_f = N_d*q_Δ/ΔH'</p>
#hide
'Heads and the stream function at the cell corners. Corners on the wall above the toe have a head on
'each side; the stream function, the flow below a corner, is integrated up each line of corners
'from the base (0), so that the wall (q) and the edges and base of the section (0) are flow lines.
o_2 = n_x + 1
o_3 = 2*(n_x + 1)
W_v = matrix_hp(n_z + 1; 3*(n_x + 1))
#for i = 0 : n_x
	#for j = 0 : n_z
		s_h = 0
		m_h = 0
		#for n_a = 0 : 1
			#for c_n = 0 : 1
				#if i + n_a ≥ 1 ∧ i + n_a ≤ n_x ∧ j + c_n ≥ 1 ∧ j + c_n ≤ n_z
					#if i + n_a ≤ n_1 ∨ j + c_n > n_e
						s_h = s_h + Φ.(j + c_n; i + n_a)
						m_h = m_h + 1
					#end if
				#end if
			#loop
		#loop
		v = s_h/max(m_h; 1)
		#if (i < n_1 ∧ j ≡ 0) ∨ (i > n_1 ∧ j ≡ n_e)
			v = if(i < n_1; η_1; η_2)
		#end if
		W_v.(j + 1; i + 1) = v
		W_v.(j + 1; o_2 + i + 1) = v
	#loop
#loop
#for j = 0 : n_d - 1
	#if j ≡ 0
		W_v.(1; n_1 + 1) = η_1
	#else
		W_v.(j + 1; n_1 + 1) = (Φ.(j; n_1) + Φ.(j + 1; n_1))/2
	#end if
	#if j ≤ n_e
		W_v.(j + 1; o_2 + n_1 + 1) = η_2
	#else
		W_v.(j + 1; o_2 + n_1 + 1) = (Φ.(j; n_1 + 1) + Φ.(j + 1; n_1 + 1))/2
	#end if
#loop
#for i = 0 : n_x
	ψ = 0
	W_v.(n_z + 1; o_3 + i + 1) = 0
	#for j = n_z : 1
		#if i ≥ 1 ∧ i < n_x ∧ (i ≠ n_1 ∨ j > n_d) ∧ (i < n_1 ∨ j > n_e)
			ψ = ψ + κ_h(j)*(Φ.(j; i) - Φ.(j; i + 1))
		#end if
		W_v.(j; o_3 + i + 1) = ψ
	#loop
#loop
'The drawing, in px: g per cell
f_z = max(η_1; η_2; 0) + 1
f_s = min(600/(n_x*δ); 300/(n_z*δ + f_z))
g_c = δ*f_s
f_0 = 16
f_W = f_0 + n_1*g_c
f_R = f_0 + n_x*g_c
f_g = 14 + f_z*f_s
f_e = f_g + n_e*g_c
f_b = f_g + n_z*g_c
f_d = f_g + n_d*g_c
f_t = f_g + n_t*g_c
f_1 = f_g - η_1*f_s
f_2 = f_g - η_2*f_s
f_H = round(f_R + f_0)
f_V = round(f_b + 62)
f_n = floor((f_R - f_0)/8) - 1
d_L = ΔH/N_d/1m
'The heave prism: the depth of the wall in front, half that wide
f_p = (d - e_x)/2/1m*f_s
P_t = vector(8)
#show
#val
'<svg alt="flownet.svg" width="'f_H'" height="'f_V'" xmlns="http://www.w3.org/2000/svg" font-family="Libre Franklin, Arial, sans-serif" font-size="11" fill="#1C1710">
'<rect x="'f_0'" y="'f_1'" width="'f_W - f_0'" height="'f_g - f_1'" fill="#2E63C4" fill-opacity="0.15"/>
'<rect x="'f_W'" y="'f_2'" width="'f_R - f_W'" height="'f_e - f_2'" fill="#2E63C4" fill-opacity="0.15"/>
'<rect x="'f_0'" y="'f_g'" width="'f_W - f_0'" height="'f_b - f_g'" fill="#F7F4EE"/>
'<rect x="'f_W'" y="'f_e'" width="'f_R - f_W'" height="'f_b - f_e'" fill="#F7F4EE"/>
#if n_t < n_z
'<rect x="'f_0'" y="'max(f_t; f_g)'" width="'f_W - f_0'" height="'f_b - max(f_t; f_g)'" fill="#EDE6D6"/>
'<rect x="'f_W'" y="'max(f_t; f_e)'" width="'f_R - f_W'" height="'f_b - max(f_t; f_e)'" fill="#EDE6D6"/>
#end if
'<rect x="'f_W'" y="'f_e'" width="'f_p'" height="'f_d - f_e'" fill="none" stroke="#C00000" stroke-width="0.9" stroke-dasharray="4 3"/>
'<g fill="none" stroke="#2FA968" stroke-width="0.9" stroke-linecap="round">
#hide
#for f = 1 : 2
	#if f ≡ 2
		#show
		'</g>
		'<g fill="none" stroke="#2E63C4" stroke-width="1.1" stroke-linecap="round">
		#hide
	#end if
	L_0 = if(f ≡ 1; η_2; 0)
	M_f = if(f ≡ 1; N_d - 1; ceiling(q_n/d_L) - 1)
	#for i = 1 : n_x
		#for j = 1 : n_z
			#if i ≤ n_1 ∨ j > n_e
				o = if(f ≡ 2; o_3; if(i ≤ n_1; 0; o_2))
				v_1 = W_v.(j; o + i)
				v_2 = W_v.(j; o + i + 1)
				v_3 = W_v.(j + 1; o + i + 1)
				v_4 = W_v.(j + 1; o + i)
				m_1 = max(1; ceiling((min(v_1; v_2; v_3; v_4) - L_0)/d_L))
				m_2 = min(M_f; floor((max(v_1; v_2; v_3; v_4) - L_0)/d_L))
				#if m_1 ≤ m_2
					x_a = f_0 + (i - 1)*g_c
					y_a = f_g + (j - 1)*g_c
					#for n_m = m_1 : m_2
						λ = L_0 + n_m*d_L
						n_p = 0
						#if (v_1 ≥ λ) ≠ (v_2 ≥ λ)
							n_p = n_p + 1
							P_t.(2*n_p - 1) = x_a + g_c*(λ - v_1)/(v_2 - v_1)
							P_t.(2*n_p) = y_a
						#end if
						#if (v_2 ≥ λ) ≠ (v_3 ≥ λ)
							n_p = n_p + 1
							P_t.(2*n_p - 1) = x_a + g_c
							P_t.(2*n_p) = y_a + g_c*(λ - v_2)/(v_3 - v_2)
						#end if
						#if (v_4 ≥ λ) ≠ (v_3 ≥ λ)
							n_p = n_p + 1
							P_t.(2*n_p - 1) = x_a + g_c*(λ - v_4)/(v_3 - v_4)
							P_t.(2*n_p) = y_a + g_c
						#end if
						#if (v_1 ≥ λ) ≠ (v_4 ≥ λ)
							n_p = n_p + 1
							P_t.(2*n_p - 1) = x_a
							P_t.(2*n_p) = y_a + g_c*(λ - v_1)/(v_4 - v_1)
						#end if
						#if n_p ≥ 2
							#show
							'<line x1="'P_t.1'" y1="'P_t.2'" x2="'P_t.3'" y2="'P_t.4'"/>
							#hide
						#end if
						#if n_p ≡ 4
							#show
							'<line x1="'P_t.5'" y1="'P_t.6'" x2="'P_t.7'" y2="'P_t.8'"/>
							#hide
						#end if
					#loop
				#end if
			#end if
		#loop
	#loop
#loop
#show
'</g>
'<line x1="'f_0'" y1="'f_g'" x2="'f_W'" y2="'f_g'" stroke="#1C1710" stroke-width="1"/>
'<line x1="'f_W'" y1="'f_e'" x2="'f_R'" y2="'f_e'" stroke="#1C1710" stroke-width="1"/>
'<line x1="'f_0'" y1="'f_g'" x2="'f_0'" y2="'f_b'" stroke="#1C1710" stroke-width="0.5"/>
'<line x1="'f_R'" y1="'f_e'" x2="'f_R'" y2="'f_b'" stroke="#1C1710" stroke-width="0.5"/>
'<line x1="'f_0'" y1="'f_b'" x2="'f_R'" y2="'f_b'" stroke="#1C1710" stroke-width="1.5"/>
#for k = 0 : f_n
'<line x1="'f_0 + 8*k'" y1="'f_b + 8'" x2="'f_0 + 8*k + 8'" y2="'f_b'" stroke="#1C1710" stroke-width="0.6"/>
#loop
'<line x1="'f_W'" y1="'f_g - (f_z - 0.4)*f_s'" x2="'f_W'" y2="'f_d'" stroke="#1C1710" stroke-width="3"/>
#if η_1 > 0
'<line x1="'f_0'" y1="'f_1'" x2="'f_W'" y2="'f_1'" stroke="#2E63C4" stroke-width="1"/>
'<polygon points="'f_0 + 24','f_1' 'f_0 + 18','f_1 - 8' 'f_0 + 30','f_1 - 8'" fill="#2E63C4"/>
#end if
#if η_2 > -n_e*δ
'<line x1="'f_W'" y1="'f_2'" x2="'f_R'" y2="'f_2'" stroke="#2E63C4" stroke-width="1"/>
'<polygon points="'f_R - 24','f_2' 'f_R - 30','f_2 - 8' 'f_R - 18','f_2 - 8'" fill="#2E63C4"/>
#end if
'<line x1="'f_0'" y1="'f_b + 26'" x2="'f_0 + 22'" y2="'f_b + 26'" stroke="#2E63C4" stroke-width="1.1"/>
'<text x="'f_0 + 28'" y="'f_b + 30'">Flow lines: 'N_f' channels</text>
'<line x1="'f_0'" y1="'f_b + 44'" x2="'f_0 + 22'" y2="'f_b + 44'" stroke="#2FA968" stroke-width="0.9"/>
'<text x="'f_0 + 28'" y="'f_b + 48'">Equipotentials: 'N_d' drops of 'd_L' m</text>
'<rect x="'f_0 + 300'" y="'f_b + 20'" width="22" height="12" fill="none" stroke="#C00000" stroke-width="0.9" stroke-dasharray="4 3"/>
'<text x="'f_0 + 328'" y="'f_b + 30'">Heave prism</text>
'</svg>
#equ
'</div>
'<!--section:exit-->
'Partial factors for hydraulic heave (EN 1997-1, Table A.17): 'γ_G,dst = 1.35' destabilising, 'γ_G,stb = 0.9' stabilising
'Buoyant unit weight: 'γ′ = γ_sat - γ_w
'Critical gradient: 'i_c = γ′/γ_w
'<h5>Piping at the exit</h5>
'Head in the cell at the downstream ground next to the wall: 'h_ex'; over the half cell above it:
'Exit gradient: 'i_e = (h_ex - H_2)/(Δ/2)
'Utilisation: 'η_pip = γ_G,dst*i_e/(γ_G,stb*i_c)
#if η_pip ≤ 1
	'<p class="ok">PASS - Exit gradient within the critical gradient, with the partial factors</p>
#else
	'<p style="color:#C00000;background-color:#FFEEEE">FAIL - Exit gradient too high: deepen the wall, or add a filter or weight at the exit</p>
#end if
'<h5>Heave of the soil in front of the wall (Terzaghi)</h5>
'Prism in front of the wall, depth: 'd_e = d - e_x
'Width: 'b_p = d_e/2
'Mean excess head at its base, from the grid: 'h_m
'Seepage force: 'S_dst,d = γ_G,dst*γ_w*h_m*b_p
'Submerged weight: 'G′_stb,d = γ_G,stb*γ′*d_e*b_p
'Utilisation: 'η_hv = S_dst,d/G′_stb,d
#if η_hv ≤ 1
	'<p class="ok">PASS - Submerged weight of the prism exceeds the seepage force (2.9b)</p>
#else
	'<p style="color:#C00000;background-color:#FFEEEE">FAIL - Heave: deepen the wall, or add weight in front of it</p>
#end if
'<!--section:wall-->
'<div>
#hide
'Points (z, u) down each face, in m and kPa: the water surface, the ground, the cell centres, the toe
γ = γ_w/(1kN/m^3)
h_t = (Φ.(n_d; n_1) + Φ.(n_d; n_1 + 1) + Φ.(n_d + 1; n_1) + Φ.(n_d + 1; n_1 + 1))/4
n_u = n_d + 3
z_u = vector(n_u)
u_u = vector(n_u)
z_u.1 = η_1
z_u.2 = 0
u_u.2 = γ*η_1
#for j = 1 : n_d
	z_u.(j + 2) = -(j - 0.5)*δ
	u_u.(j + 2) = γ*(Φ.(j; n_1) + (j - 0.5)*δ)
#loop
z_u.(n_u) = -n_d*δ
u_u.(n_u) = γ*(h_t + n_d*δ)
n_w = n_d - n_e + 3
z_w = vector(n_w)
u_w = vector(n_w)
z_w.1 = η_2
z_w.2 = -n_e*δ
u_w.2 = γ*(η_2 + n_e*δ)
#for j = n_e + 1 : n_d
	z_w.(j - n_e + 2) = -(j - 0.5)*δ
	u_w.(j - n_e + 2) = γ*(Φ.(j; n_1 + 1) + (j - 0.5)*δ)
#loop
z_w.(n_w) = -n_d*δ
u_w.(n_w) = γ*(h_t + n_d*δ)
'Forces (trapezia) and their moments about the toe
F_u = 0
M_u = 0
#for k = 1 : n_u - 1
	ℓ = z_u.k - z_u.(k + 1)
	F_u = F_u + (u_u.k + u_u.(k + 1))/2*ℓ
	M_u = M_u + ℓ^2*(2*u_u.k + u_u.(k + 1))/6 + (u_u.k + u_u.(k + 1))/2*ℓ*(z_u.(k + 1) + n_d*δ)
#loop
F_w = 0
M_w = 0
#for k = 1 : n_w - 1
	ℓ = z_w.k - z_w.(k + 1)
	F_w = F_w + (u_w.k + u_w.(k + 1))/2*ℓ
	M_w = M_w + ℓ^2*(2*u_w.k + u_w.(k + 1))/6 + (u_w.k + u_w.(k + 1))/2*ℓ*(z_w.(k + 1) + n_d*δ)
#loop
P_1 = F_u*1kN/m
P_2 = F_w*1kN/m
a_w = (M_u - M_w)/(F_u - F_w)*1m
'The diagram, in px: the wall in the middle, the pressure on the upstream face to the left
p_z = max(η_1; η_2; 0)
p_s = 240/(p_z + n_d*δ)
p_u = 150/max(max(u_u); max(u_w); 1)
p_c = 250
p_y(z) = 24 + (p_z - z)*p_s
p_H = 500
p_V = round(p_y(-n_d*δ) + 30)
#show
'<p>Pore pressure <i>u</i> = <i>γ</i><sub>w</sub>·(<i>h</i> − <i>z</i>) on each face, from the heads in the cells beside the wall; hydrostatic in the water above the ground.</p>
#val
'<svg alt="wall.svg" width="'p_H'" height="'p_V'" xmlns="http://www.w3.org/2000/svg" font-family="Libre Franklin, Arial, sans-serif" font-size="11" fill="#1C1710">
#for k = 1 : n_u - 1
'<polygon points="'p_c','p_y(z_u.k)' 'p_c - p_u*u_u.k','p_y(z_u.k)' 'p_c - p_u*u_u.(k + 1)','p_y(z_u.(k + 1))' 'p_c','p_y(z_u.(k + 1))'" fill="#2E63C4" fill-opacity="0.18"/>
'<line x1="'p_c - p_u*u_u.k'" y1="'p_y(z_u.k)'" x2="'p_c - p_u*u_u.(k + 1)'" y2="'p_y(z_u.(k + 1))'" stroke="#2E63C4" stroke-width="1.2"/>
#loop
#for k = 1 : n_w - 1
'<polygon points="'p_c','p_y(z_w.k)' 'p_c + p_u*u_w.k','p_y(z_w.k)' 'p_c + p_u*u_w.(k + 1)','p_y(z_w.(k + 1))' 'p_c','p_y(z_w.(k + 1))'" fill="#2E63C4" fill-opacity="0.18"/>
'<line x1="'p_c + p_u*u_w.k'" y1="'p_y(z_w.k)'" x2="'p_c + p_u*u_w.(k + 1)'" y2="'p_y(z_w.(k + 1))'" stroke="#2E63C4" stroke-width="1.2"/>
#loop
'<line x1="'p_c'" y1="'p_y(p_z) - 8'" x2="'p_c'" y2="'p_y(-n_d*δ)'" stroke="#1C1710" stroke-width="3"/>
'<line x1="'p_c - 170'" y1="'p_y(0)'" x2="'p_c'" y2="'p_y(0)'" stroke="#1C1710" stroke-width="0.75" stroke-dasharray="3 2"/>
'<line x1="'p_c'" y1="'p_y(-n_e*δ)'" x2="'p_c + 170'" y2="'p_y(-n_e*δ)'" stroke="#1C1710" stroke-width="0.75" stroke-dasharray="3 2"/>
'<text x="'p_c - p_u*u_u.2 - 6'" y="'p_y(0) - 4'" text-anchor="end">'u_u.2' kPa</text>
'<text x="'p_c - p_u*u_u.(n_u) - 6'" y="'p_y(-n_d*δ) + 4'" text-anchor="end">'u_u.(n_u)' kPa</text>
'<text x="'p_c + p_u*u_w.2 + 6'" y="'p_y(-n_e*δ) - 4'">'u_w.2' kPa</text>
'<text x="'p_c + p_u*u_w.(n_w) + 6'" y="'p_y(-n_d*δ) + 4'">'u_w.(n_w)' kPa</text>
'<text x="'p_c - 172'" y="'p_y(0) + 13'" fill="#6B655C">ground</text>
'<text x="'p_c + 172'" y="'p_y(-n_e*δ) + 13'" text-anchor="end" fill="#6B655C">ground</text>
'<text x="'p_c - 8'" y="14" text-anchor="end" font-weight="bold">Upstream face</text>
'<text x="'p_c + 8'" y="14" font-weight="bold">Downstream face</text>
'</svg>
#equ
'Forces per metre of wall: 'P_1' on the upstream face, 'P_2' on the downstream face
'Net force: 'P_w = P_1 - P_2
'Acting above the toe at: 'a_w
'</div>
