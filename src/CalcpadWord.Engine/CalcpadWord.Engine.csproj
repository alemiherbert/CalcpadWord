  <ItemGroup>
    <ProjectReference Include="..\..\calcpad\Calcpad.Core\Calcpad.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CalcpadWord.Engine.Tests" />
  </ItemGroup>
</Project>
