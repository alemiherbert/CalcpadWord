<Project Sdk="Microsoft.NET.Sdk">
  <!-- Throwaway harness: confirms how Calcpad.Core behaves when driven one expression at a time,
       the way an inline Word plugin would drive it. Not part of the plugin itself. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\calcpad\Calcpad.Core\Calcpad.Core.csproj" />
  </ItemGroup>
</Project>
